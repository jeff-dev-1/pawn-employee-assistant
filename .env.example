# ---------------------------------------------------------------------------
# Ports. Never hard-code a port in source; every one of them is read from here.
# ---------------------------------------------------------------------------
WEB_PORT=3000
HR_PORT=3101

# Where the MCP servers announce themselves.
ORCHESTRATOR_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM channel. Unused until Prompt 5; listed here so the shape is visible early.
# Any value containing a space must be quoted, or `set -a; . ./.env` breaks.
# ---------------------------------------------------------------------------
LLM_PROVIDER=portkey

# --- portkey channel ---
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=

# --- direct channel ---
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=

# Model roles. Planning needs stable JSON; synthesis needs good prose.
# Model ids move faster than any document. Verified 2026-08-31; re-check with:
#   curl -sH "Authorization: Bearer $DEEPSEEK_API_KEY" https://api.deepseek.com/v1/models
PLANNER_VENDOR=deepseek
MODEL_PLANNER=deepseek-v4-flash
WRITER_VENDOR=moonshot
MODEL_WRITER=kimi-k3

# Optional Portkey virtual keys, one per vendor. With none set the gateway forwards the
# vendor key from this file instead.
PORTKEY_VK_DEEPSEEK=
PORTKEY_VK_MOONSHOT=
PORTKEY_VK_QWEN=

# The demo runs as one employee; real auth is out of scope.
DEMO_USER="Yuki Tanaka"
