# ---------------------------------------------------------------------------
# Ports. Never hard-code a port in source; every one of them is read from here.
# ---------------------------------------------------------------------------
WEB_PORT=3000
HR_PORT=3101
IT_PORT=3102
POLICY_PORT=3103

# Where the MCP servers announce themselves.
ORCHESTRATOR_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM channel. Unused until Prompt 5; listed here so the shape is visible early.
# Any value containing a space must be quoted, or `set -a; . ./.env` breaks.
# ---------------------------------------------------------------------------
LLM_PROVIDER=portkey

# --- portkey channel ---
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=

# --- direct channel ---
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=

# Model roles. Planning needs stable JSON; synthesis needs good prose.
# Model ids move faster than any document. Verified 2026-08-31; re-check with:
#   curl -sH "Authorization: Bearer $DEEPSEEK_API_KEY" https://api.deepseek.com/v1/models
PLANNER_VENDOR=deepseek
MODEL_PLANNER=deepseek-v4-flash
WRITER_VENDOR=moonshot
MODEL_WRITER=kimi-k3

# Optional Portkey virtual keys, one per vendor. With none set the gateway forwards the
# vendor key from this file instead.
# The config a request runs under, and the only way to say which policy is enforcing.
# A CONFIG slug starts with pc- ; a GUARDRAIL slug starts with pg- and is NOT accepted here.
# The config is what carries "deny": a guardrail can detect a threat and the request still
# succeeds unless the config that references it sets deny. Leave empty and the gateway
# applies the account default, which works and leaves nobody able to say what ran.
#   { "input_guardrails":  [ { "id": "pg-...", "deny": true } ],
#     "output_guardrails": [ { "id": "pg-...", "deny": true } ] }
PORTKEY_CONFIG=

PORTKEY_VK_DEEPSEEK=
PORTKEY_VK_MOONSHOT=
PORTKEY_VK_QWEN=

# Fallback routing. Two or more vendors, in order; the gateway tries the next one when the
# current one returns a retryable status. Empty or one vendor means no routing config at all
# and everything behaves as it did before this variable existed.
#   npm run fallback     shows which target served each probe
FALLBACK_VENDORS=

# Per-vendor model, needed only for fallback: each target names its own, and MODEL_WRITER
# cannot speak for a vendor the request has not reached yet. Unset falls back to the table
# in apps/web/lib/llm.ts.
MODEL_DEEPSEEK=
MODEL_MOONSHOT=
MODEL_QWEN=

# The GUARDRAIL slug (pg-), which is a different object from PORTKEY_CONFIG (pc-) above.
# With FALLBACK_VENDORS set, the routing config occupies the one config header, so the
# guardrail has to be attached per target by its own slug instead of through a config.
# Leave this empty while fallback is on and the requests go out unguarded.
PORTKEY_GUARDRAIL=

# The demo runs as one employee; real auth is out of scope.
DEMO_USER="Yuki Tanaka"

# ---------------------------------------------------------------------------
# Appendix D: the guardrail on the CREDENTIAL rather than on the request.
# A second Portkey key with the guardrail config bound to it in the dashboard. Set it and
# the app stops sending x-portkey-config: the rule now lives on the key, so the application
# cannot issue an unguarded request without holding a different key. That is the production
# posture. Leave it empty for the classroom, where mode 2 and mode 3 differing by one header
# is the entire demonstration.
PORTKEY_API_KEY_GUARDED=

# ---------------------------------------------------------------------------
# Appendix E: deep links into the gateway's logs. None of these are secrets - every one is
# visible in a dashboard URL. Without them the UI prints a trace id nobody can act on.
#   standalone Portkey : PORTKEY_ORG_ID + PORTKEY_WORKSPACE_ID
#   Strata Cloud Manager: also PORTKEY_DEPLOYMENT_ID (the licenseId in SCM URLs)
#                         and PRISMA_AIRS_TSG_ID
PORTKEY_ORG_ID=
PORTKEY_WORKSPACE_ID=
PORTKEY_DEPLOYMENT_ID=
PRISMA_AIRS_TSG_ID=
