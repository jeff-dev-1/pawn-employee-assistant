# ---------------------------------------------------------------------------
# Ports. Never hard-code a port in source; every one of them is read from here.
# ---------------------------------------------------------------------------
WEB_PORT=3000
HR_PORT=3101

# Where the MCP servers announce themselves.
ORCHESTRATOR_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM channel. Unused until Prompt 5; listed here so the shape is visible early.
# Any value containing a space must be quoted, or `set -a; . ./.env` breaks.
# ---------------------------------------------------------------------------
LLM_PROVIDER=portkey

# --- portkey channel ---
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=

# --- direct channel ---
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=

# Model roles.
PLANNER_VENDOR=deepseek
MODEL_PLANNER=
WRITER_VENDOR=deepseek
MODEL_WRITER=

# The demo runs as one employee; real auth is out of scope.
DEMO_USER="Yuki Tanaka"
